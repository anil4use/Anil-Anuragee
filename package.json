{
  "name": "anil-portfolio-monorepo",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.5.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "admin:hash-password": "node scripts/admin-password-hash.mjs",
    "build": "npm run build --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "db:seed": "node --env-file=.env.local scripts/db-seed.mjs"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "prettier": "^3.4.0",
    "turbo": "^2.1.3",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@types/sanitize-html": "^2.16.2",
    "marked": "^18.1.1",
    "mongodb": "^6.10.0",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  }
}
