# Shared application settings
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=anil_portfolio
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Admin and public portfolio share the same origin and port.
ADMIN_ORIGIN=http://localhost:3000
ADMIN_EMAIL=you@example.com
# Create with: npm run admin:hash-password
ADMIN_PASSWORD_HASH=
# Generate a high-entropy random value for the unified application.
SESSION_SECRET=

# Cloudinary signed uploads for blog images (optional until configured)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI providers: configure one server-side key. Never use NEXT_PUBLIC_ for provider secrets.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=Anil Portfolio
